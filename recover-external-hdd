#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s nullglob

ROOT_UUID="741133ee-fa8d-4674-8809-2735e197acae"
BOOT_UUID="BACA-0001"
ROOT_LABEL="SSD_BACKUP"
BOOT_LABEL="BACKUPBOOT"
TARGET="/mnt"
NIXPKGS_REV="9ae611a455b90cf061d8f332b977e387bda8e1ca"
VALIDATED_CONFIG_REV="f5ede4b1e455bb3275ec9e71368da6c80daa0b85"
CONFIG_REPO="expgolemclone/nix-config"
YAZI_SOURCE="$TARGET/home/exp/projects/yazi_fork"
GH_CONFIG_DIR_BACKUP="$TARGET/home/exp/.config/gh"
REPORT_MODE="${RECOVERY_REPORT_MODE:-off}"
REPORT_REPO="${RECOVERY_REPORT_REPO:-expgolemclone/nix-config}"
REPORT_ISSUE="${RECOVERY_REPORT_ISSUE:-20}"
DRACUT_PACKAGE="github:NixOS/nixpkgs/$NIXPKGS_REV#dracut"
GH_PACKAGE="github:NixOS/nixpkgs/$NIXPKGS_REV#gh"
RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)"
WORK_DIR="/tmp/external-hdd-recovery-$RUN_ID"
LOG="$WORK_DIR/recovery.log"
CHECKS="$WORK_DIR/checks.tsv"
REPORT="$WORK_DIR/report.md"
INITRD_LIST="$WORK_DIR/initrd-files.txt"
SYSTEM_PATH=""
SPEC_SYSTEM=""
BOOT_ENTRY=""
REPORTING_READY=0

mkdir -p "$WORK_DIR"
: > "$CHECKS"
exec > >(tee -a "$LOG") 2>&1

nix_cmd() {
  nix --extra-experimental-features 'nix-command flakes' "$@"
}

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

record_check() {
  local status="$1"
  local name="$2"
  local detail="$3"
  detail="${detail//$'\t'/ }"
  detail="${detail//$'\n'/ }"
  printf '%s\t%s\t%s\n' "$status" "$name" "$detail" >> "$CHECKS"
  printf '[%s] %s: %s\n' "$status" "$name" "$detail"
}

pass() {
  record_check PASS "$1" "$2"
}

require_equal() {
  local name="$1"
  local actual="$2"
  local expected="$3"
  [ "$actual" = "$expected" ] || {
    record_check FAIL "$name" "expected $expected, got $actual"
    fail "$name verification failed"
  }
  pass "$name" "$actual"
}

same_device() {
  [ "$(readlink -f "$1")" = "$(readlink -f "$2")" ]
}

target_is_rw() {
  mountpoint -q "$TARGET" \
    && findmnt -n -o OPTIONS --target "$TARGET" | grep -Eq '(^|,)rw(,|$)'
}

sanitize_log() {
  tail -n 120 "$LOG" \
    | sed -E \
      -e $'s/\x1B\[[0-9;]*[[:alpha:]]//g' \
      -e 's#gh[pousr]_[A-Za-z0-9_]+#<redacted-token>#g' \
      -e 's#github_pat_[A-Za-z0-9_]+#<redacted-token>#g' \
      -e 's#(Authorization:|authorization:)[[:space:]]*[^[:space:]]+#\1 <redacted>#g' \
      -e "s#$TARGET/home/exp#<backup-home>#g"
}

render_report() {
  local rc="$1"
  local outcome="SUCCESS"
  [ "$rc" -eq 0 ] || outcome="FAILED"

  {
    printf '## External HDD recovery report\n\n'
    printf -- '- Run: `%s`\n' "$RUN_ID"
    printf -- '- Status: **%s** (exit %s)\n' "$outcome" "$rc"
    printf -- '- Config revision: `%s`\n' "$VALIDATED_CONFIG_REV"
    printf -- '- Built system: `%s`\n' "${SYSTEM_PATH:-not-built}"
    printf -- '- Boot entry: `%s`\n\n' "${BOOT_ENTRY:-not-installed}"
    printf '| Status | Check | Detail |\n'
    printf '|---|---|---|\n'
    while IFS=$'\t' read -r status name detail; do
      detail="${detail//|/\\|}"
      printf '| %s | %s | %s |\n' "$status" "$name" "$detail"
    done < "$CHECKS"
    printf '\n### Recent sanitized log\n\n```text\n'
    sanitize_log
    printf '\n```\n'
  } > "$REPORT"
}

run_gh() {
  GH_CONFIG_DIR="$GH_CONFIG_DIR_BACKUP" \
    nix_cmd shell "$GH_PACKAGE" --command gh "$@"
}

prepare_optional_reporting() {
  case "$REPORT_MODE" in
    off)
      pass reporting 'disabled'
      return
      ;;
    github)
      [ -f "$GH_CONFIG_DIR_BACKUP/hosts.yml" ] \
        || fail "GitHub reporting requested, but $GH_CONFIG_DIR_BACKUP/hosts.yml is missing"
      run_gh auth status --hostname github.com
      run_gh api "repos/$REPORT_REPO/issues/$REPORT_ISSUE" --jq .number >/dev/null
      REPORTING_READY=1
      pass reporting "$REPORT_REPO issue $REPORT_ISSUE"
      ;;
    *)
      fail 'RECOVERY_REPORT_MODE must be off or github'
      ;;
  esac
}

publish_optional_report() {
  local rc="$1"
  local persistent_dir
  render_report "$rc"

  if target_is_rw; then
    persistent_dir="$TARGET/var/log/external-hdd-recovery/$RUN_ID"
    mkdir -p "$persistent_dir"
    cp -f "$LOG" "$CHECKS" "$REPORT" "$persistent_dir/"
    printf 'Persistent report: %s\n' "$persistent_dir"
  else
    printf 'Temporary report: %s\n' "$REPORT"
  fi

  if [ "$REPORTING_READY" -eq 1 ]; then
    if ! run_gh issue comment "$REPORT_ISSUE" --repo "$REPORT_REPO" --body-file "$REPORT"; then
      printf 'WARNING: optional GitHub report upload failed. The disk recovery result is unchanged.\n' >&2
    fi
  fi
}

on_exit() {
  local rc="$?"
  trap - EXIT
  set +e
  publish_optional_report "$rc"
  exit "$rc"
}
trap on_exit EXIT

[ "${EUID:-$(id -u)}" -eq 0 ] || fail 'run this script as root'
[ -d /sys/firmware/efi ] || fail 'boot the NixOS installer in UEFI mode'

required_commands=(
  awk blkid cp date df findmnt grep jq lsblk mkdir mktemp mount mountpoint
  nix nixos-install readlink sed sha256sum sync tail tee uname
)
for command_name in "${required_commands[@]}"; do
  command -v "$command_name" >/dev/null || fail "missing installer command: $command_name"
done
pass toolchain "${#required_commands[@]} required installer commands found"

root_dev="/dev/disk/by-uuid/$ROOT_UUID"
boot_dev="/dev/disk/by-uuid/$BOOT_UUID"
[ -b "$root_dev" ] || fail "backup root UUID $ROOT_UUID is not present"
[ -b "$boot_dev" ] || fail "backup boot UUID $BOOT_UUID is not present"
root_real="$(readlink -f "$root_dev")"
boot_real="$(readlink -f "$boot_dev")"
[ "$root_real" != "$boot_real" ] || fail 'backup root and boot resolve to the same block device'

require_equal root-filesystem "$(blkid -s TYPE -o value "$root_real")" ext4
require_equal root-label "$(blkid -s LABEL -o value "$root_real")" "$ROOT_LABEL"
require_equal boot-filesystem "$(blkid -s TYPE -o value "$boot_real")" vfat
require_equal boot-label "$(blkid -s LABEL -o value "$boot_real")" "$BOOT_LABEL"

root_parent="$(lsblk -no PKNAME "$root_real" | awk 'NF { print; exit }')"
boot_parent="$(lsblk -no PKNAME "$boot_real" | awk 'NF { print; exit }')"
[ -n "$root_parent" ] && [ "$root_parent" = "$boot_parent" ] \
  || fail "root and boot are not partitions of the same disk ($root_parent / $boot_parent)"
pass disk-layout "$root_real and $boot_real are on /dev/$root_parent"

mkdir -p "$TARGET" "$TARGET/boot"
if mountpoint -q "$TARGET"; then
  same_device "$(findmnt -n -o SOURCE --target "$TARGET")" "$root_real" \
    || fail "$TARGET is mounted from the wrong device"
  mount -o remount,ro "$TARGET"
else
  mount -o ro "$root_real" "$TARGET"
fi
if mountpoint -q "$TARGET/boot"; then
  same_device "$(findmnt -n -o SOURCE --target "$TARGET/boot")" "$boot_real" \
    || fail "$TARGET/boot is mounted from the wrong device"
  mount -o remount,ro "$TARGET/boot"
else
  mount -t vfat -o ro "$boot_real" "$TARGET/boot"
fi
findmnt -n -o OPTIONS --target "$TARGET" | grep -Eq '(^|,)ro(,|$)' \
  || fail 'backup root is not read-only during preflight'
findmnt -n -o OPTIONS --target "$TARGET/boot" | grep -Eq '(^|,)ro(,|$)' \
  || fail 'backup ESP is not read-only during preflight'
pass preflight-read-only 'root and ESP are read-only'

root_free_kib="$(df -Pk "$TARGET" | awk 'NR == 2 { print $4 }')"
boot_free_kib="$(df -Pk "$TARGET/boot" | awk 'NR == 2 { print $4 }')"
[ "$root_free_kib" -ge 1048576 ] || fail 'backup root has less than 1 GiB free'
[ "$boot_free_kib" -ge 131072 ] || fail 'backup ESP has less than 128 MiB free'
pass free-space "$((root_free_kib / 1024)) MiB root, $((boot_free_kib / 1024)) MiB ESP"

[ -f "$YAZI_SOURCE/flake.nix" ] || fail "missing backed-up yazi_fork at $YAZI_SOURCE"
prepare_optional_reporting

FLAKE_REF="github:$CONFIG_REPO/$VALIDATED_CONFIG_REV"
SYSTEM_INSTALLABLE="$FLAKE_REF#nixosConfigurations.nixos.config.system.build.toplevel"

printf '\nResolving the pinned configuration while the backup remains read-only...\n'
config_metadata="$(nix_cmd flake metadata --json --no-write-lock-file \
  --override-input yazi-fork "path:$YAZI_SOURCE" "$FLAKE_REF")"
resolved_config_rev="$(printf '%s' "$config_metadata" | jq -r '.locked.rev // empty')"
require_equal config-revision "$resolved_config_rev" "$VALIDATED_CONFIG_REV"

printf '\nBuilding the pinned system before touching the ESP...\n'
mount -o remount,rw "$TARGET"
findmnt -n -o OPTIONS --target "$TARGET" | grep -Eq '(^|,)rw(,|$)' \
  || fail 'backup root could not be remounted read-write'
pass root-read-write 'ESP remains read-only'

build_dir="$(mktemp -d -p "$TARGET" .external-hdd-recovery-build.XXXXXX)"
system_link="$build_dir/system"
nix_cmd build \
  --no-write-lock-file \
  --override-input yazi-fork "path:$YAZI_SOURCE" \
  --store "$TARGET" \
  --extra-substituters 'auto?trusted=1' \
  --out-link "$system_link" \
  "$SYSTEM_INSTALLABLE"
SYSTEM_PATH="$(readlink -f "$system_link")"
[ -x "$SYSTEM_PATH/init" ] || fail "built system has no executable init: $SYSTEM_PATH"
pass system-build "$SYSTEM_PATH"

SPEC_SYSTEM="$SYSTEM_PATH/specialisation/external-hdd-backup"
[ -x "$SPEC_SYSTEM/init" ] || fail 'external-hdd-backup specialisation has no executable init'
[ -f "$SPEC_SYSTEM/initrd" ] || fail 'external-hdd-backup specialisation has no initrd'
[ -f "$SPEC_SYSTEM/etc/fstab" ] || fail 'external-hdd-backup specialisation has no generated fstab'
pass specialisation "$SPEC_SYSTEM"

root_fstab_device="$(awk '$2 == "/" { print $1; exit }' "$SPEC_SYSTEM/etc/fstab")"
root_fstab_options="$(awk '$2 == "/" { print $4; exit }' "$SPEC_SYSTEM/etc/fstab")"
boot_fstab_device="$(awk '$2 == "/boot" { print $1; exit }' "$SPEC_SYSTEM/etc/fstab")"
require_equal evaluated-root-device "$root_fstab_device" "$root_dev"
require_equal evaluated-boot-device "$boot_fstab_device" "$boot_dev"
case ",$root_fstab_options," in
  *,x-systemd.device-timeout=5min,*) pass root-device-timeout "$root_fstab_options" ;;
  *) fail "generated root fstab lacks x-systemd.device-timeout=5min: $root_fstab_options" ;;
esac

printf '\nInspecting the built initrd...\n'
nix_cmd shell "$DRACUT_PACKAGE" --command lsinitrd "$SPEC_SYSTEM/initrd" > "$INITRD_LIST"
for module_spec in \
  'xhci_pci:xhci[-_]pci\.ko' \
  'sd_mod:sd_mod\.ko' \
  'uas:uas\.ko' \
  'usb_storage:usb-storage\.ko'
do
  module_name="${module_spec%%:*}"
  module_pattern="${module_spec#*:}"
  grep -Eq "/${module_pattern}(\.(xz|zst|gz))?$" "$INITRD_LIST" \
    || fail "required module $module_name is missing from the built initrd"
  pass "initrd-module-$module_name" 'present'
done
built_initrd_hash="$(sha256sum "$SPEC_SYSTEM/initrd" | awk '{print $1}')"
pass built-initrd-hash "$built_initrd_hash"

printf '\nInstalling only the already-built and verified system...\n'
mount -o remount,rw "$TARGET/boot"
findmnt -n -o OPTIONS --target "$TARGET/boot" | grep -Eq '(^|,)rw(,|$)' \
  || fail 'backup ESP could not be remounted read-write'
pass boot-read-write 'enabled after build and initrd verification'

nixos-install \
  --root "$TARGET" \
  --system "$SYSTEM_PATH" \
  --no-channel-copy \
  --no-root-passwd
sync

require_equal installed-profile \
  "$(readlink -f "$TARGET/nix/var/nix/profiles/system")" \
  "$SYSTEM_PATH"

entries=("$TARGET"/boot/loader/entries/*external-hdd-backup*.conf)
[ "${#entries[@]}" -gt 0 ] || fail 'no external-hdd-backup boot entry was generated'
BOOT_ENTRY="${entries[0]}"
for entry in "${entries[@]}"; do
  [ "$entry" -nt "$BOOT_ENTRY" ] && BOOT_ENTRY="$entry"
done
pass boot-entry "$BOOT_ENTRY"

boot_initrd_rel="$(awk '$1 == "initrd" { value=$2 } END { print value }' "$BOOT_ENTRY")"
boot_options="$(awk '$1 == "options" { sub(/^options[[:space:]]+/, ""); print; exit }' "$BOOT_ENTRY")"
[ -n "$boot_initrd_rel" ] && [ -f "$TARGET/boot$boot_initrd_rel" ] \
  || fail "boot entry initrd is missing: $boot_initrd_rel"
require_equal installed-initrd-hash \
  "$(sha256sum "$TARGET/boot$boot_initrd_rel" | awk '{print $1}')" \
  "$built_initrd_hash"

spec_init_target="$(readlink -f "$SPEC_SYSTEM/init")"
spec_init_boot="${spec_init_target#"$TARGET"}"
case " $boot_options " in
  *" init=$spec_init_boot "*) pass boot-init-target "$spec_init_boot" ;;
  *) fail "boot entry does not point at the verified specialisation init: $spec_init_boot" ;;
esac

sync
pass final-sync 'all target writes flushed'
printf '\nRecovery completed successfully.\n'
printf 'Reboot and select the newest external-hdd-backup entry on the BUFFALO HDD.\n'
printf 'After boot, connect from VAIO with: ssh exp@192.168.137.2\n'
